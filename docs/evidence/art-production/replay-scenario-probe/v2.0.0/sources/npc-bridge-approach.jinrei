senkei npc_bridge_approach { action advance_slot_1 { when match.tick == 1, do move(argmin hero in filter hero in allies.heroes { hero.slot_id == "slot-1", } by hero.hp then hero.id, "A.BOT.BANK"), }, action advance_slot_2 { when match.tick == 1, do move(argmin hero in filter hero in allies.heroes { hero.slot_id == "slot-2", } by hero.hp then hero.id, "A.BOT.BANK"), }, action advance_slot_3 { when match.tick == 1, do move(argmin hero in filter hero in allies.heroes { hero.slot_id == "slot-3", } by hero.hp then hero.id, "A.BOT.BANK"), }, action advance_slot_4 { when match.tick == 1, do move(argmin hero in filter hero in allies.heroes { hero.slot_id == "slot-4", } by hero.hp then hero.id, "A.BOT.BANK"), }, action advance_slot_5 { when match.tick == 1, do move(argmin hero in filter hero in allies.heroes { hero.slot_id == "slot-5", } by hero.hp then hero.id, "A.BOT.BANK"), } }