{
  "name": "senkei-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.graphics.json && tsc --noEmit -p packages/jinrei-editor/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "contract:types": "json2ts packages/replay-contract/replay.schema.json packages/replay-contract/src/generated.ts --bannerComment '/* Generated from replay.schema.json. Run npm run contract:types. */'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@senkei/renderer": "*",
    "@senkei/replay-contract": "*",
    "@senkei/replay-player": "*",
    "ajv": "^8.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.6",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "version": "0.1.0"
}
